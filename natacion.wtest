import cursos.*
import docentes.*
import estudiantes.*
import tiposdenado.*


describe "natacion" {

  const debi = new DocenteBasico(esGuardavidas = false)
  const isa = new DocenteBasico(esGuardavidas = true)
  const nico = new Dedicado(estilo = pecho, esGuardavidas = false)
  const mara = new Externo(esGuardavidas = false, limiteDeCupo = 2)
  const milena = new Estudiante(edad = 10, estilosDominados = #{croll, pecho})
  const rodrigo = new Estudiante(edad = 9, estilosDominados =#{mariposa, pecho})
  const matilda = new Estudiante(edad = 9, estilosDominados = #{croll, pecho})
  const elias = new Estudiante(edad = 15)
  const camilo = new Estudiante(edad=16, estilosDominados = #{croll,pecho, espalda})
  const juana = new Estudiante(edad=16, estilosDominados=#{croll})

  const martes = new CursoBase(docente = debi, cupoMaximo = 3, estudiantesInscriptos =#{milena, rodrigo})
  const jueves = new CursoBase(docente = isa, cupoMaximo = 3, estudiantesInscriptos=#{milena,rodrigo})
  const viernes = new CursoBase(docente = nico, cupoMaximo = 3, estudiantesInscriptos = #{milena, rodrigo})
  const colonia = new EscuelitaDeNiños(docente=debi, cupoMaximo = 3, estudiantesInscriptos=#{milena,rodrigo})
  const rehabilitacion = new Terapeutico(docente = mara, cupoMaximo =4, estudiantesInscriptos = #{milena, camilo})
 
  
  test "1. a. curso basico (no guardavida)" {
    assert.notThat(martes.puedeInscribirse(milena))
    assert.that(martes.puedeInscribirse(matilda))
    assert.that(martes.puedeInscribirse(camilo))
    assert.notThat(martes.puedeInscribirse(elias))
    assert.throwsException({martes.inscribirA(elias)})
    assert.throwsException({martes.inscribirA(matilda)})
    assert.equals(#{milena,rodrigo,matilda}, martes.estudiantesInscriptos())
    assert.notThat(martes.puedeInscribirse(camilo))
  }

  test "1. b. curso basico (guardavida)" {
     assert.that(jueves.puedeInscribirse(elias))
     jueves.inscribirA(elias)
     assert.equals(#{milena,rodrigo,elias}, jueves.estudiantesInscriptos()) 
   }

  test "1.c. curso basico docente dedicado" {
    assert.notThat(viernes.puedeInscribirse(milena))
    assert.that(viernes.puedeInscribirse(matilda))
    assert.that(viernes.puedeInscribirse(camilo))
    assert.notThat(viernes.puedeInscribirse(juana))
    assert.throwsException({viernes.inscribirA(juana)})
    assert.equals(#{milena,rodrigo,matilda}, viernes.estudiantesInscriptos())
    assert.notThat(viernes.puedeInscribirse(camilo))
    assert.throwsException({viernes.inscribirA(camilo)})
 }
test "1.d. escuela de niños" {
  assert.notThat(colonia.puedeInscribirse(milena))
  assert.that(colonia.puedeInscribirse(matilda))
  assert.notThat(colonia.puedeInscribirse(camilo))
  assert.notThat(colonia.puedeInscribirse(elias))
  assert.throwsException({colonia.inscribirA(camilo)})
  assert.throwsException({colonia.inscribirA(elias)})
  colonia.inscribirA(matilda)
  assert.equals(#{milena,rodrigo,matilda}, colonia.estudiantesInscriptos())
}
 test "1.e terapeutico (docente externo)" {
  assert.notThat(rehabilitacion.puedeInscribirse(milena))
  assert.notThat(rehabilitacion.puedeInscribirse(juana))
  assert.that(rehabilitacion.puedeInscribirse(matilda))
  assert.that(rehabilitacion.puedeInscribirse(rodrigo))
  rehabilitacion.inscribirA(matilda)
  assert.throwsException({rehabilitacion.inscribirA(rodrigo)})
  assert.equals(#{milena,camilo,matilda}, rehabilitacion.estudiantesInscriptos())
 }

}
